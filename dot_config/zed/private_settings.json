// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "diagnostics": {
    "inline": {
      "enabled": true,
      "max_severity": null // same values as the `diagnostics_max_severity` from the editor settings
    }
  },
  "auto_install_extensions": {
    "bearded-theme": true,
    "dockerfile": true,
    "emmet": true,
    "git-firefly": true,
    "html": true,
    "intl-lens": true,
    "log": true,
    "make": true,
    "material-icon-theme": true,
    "php": true,
    "phpcs": true,
    "react-snippets-es7": true,
    "scss": true,
    "stylelint": true,
    "xml": true
  },
  "bottom_dock_layout": "full",
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "icon_theme": "Material Icon Theme",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "project_panel": {
    "dock": "left",
    "auto_fold_dirs": false
  },
  "base_keymap": "VSCode",
  "autosave": "on_window_change",
  "buffer_font_family": "FiraCode Nerd Font",
  "buffer_font_fallbacks": [".ZedMono"],
  "file_types": {
    "twig": ["*.html"],
    "ansible": ["**/roles/**/*.yml"],
    "yaml": ["*.yml"]
  },
  "colorize_brackets": true,
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "minimap": {
    "show": "auto"
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Bearded Theme Black & Emerald Soft"
  },
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": false,
    "show_other_hints": true
  },
  "lsp": {
    "intelephense": {
      "initialization_options": {
        "storagePath": "/home/felix/.cache/intelephense"
      }
    },
    "phpstan": {
      "binary": {
        "path": "/home/felix/dev/zed-extensions/phpstan-zed/target/release/phpstan-lsp-server"
      },
      "settings": {
        "phpstan_path": "vendor/bin/phpstan",
        "phpstan_memory_limit": "2G"
      }
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "inlayHints": {
            "variableTypes": { "enabled": false },
            "functionLikeReturnTypes": { "enabled": false },
            "propertyDeclarationTypes": { "enabled": false },
            "parameterNames": { "enabled": "none" },
            "parameterTypes": { "enabled": false },
            "enumMemberValues": { "enabled": false }
          }
        },
        "javascript": {
          "inlayHints": {
            "variableTypes": { "enabled": false },
            "functionLikeReturnTypes": { "enabled": false },
            "propertyDeclarationTypes": { "enabled": false },
            "parameterNames": { "enabled": "none" },
            "parameterTypes": { "enabled": false },
            "enumMemberValues": { "enabled": false }
          }
        }
      }
    }
  },
  "tab_size": 2,
  "formatter": {
    "external": {
      "command": "prettier",
      "arguments": ["--stdin-filepath", "{buffer_path}"]
    }
  },
  "languages": {
    "PHP": {
      "language_servers": ["!phpactor", "intelephense", "phpcs", "phpstan"],
      "tab_size": 4,
      "formatter": {
        "external": {
          "command": "docker",
          "arguments": [
            "exec",
            "-i",
            "core",
            "vendor/bin/phpcbf",
            "--standard=.phpcs.xml",
            "--stdin-path={buffer_path}",
            "-"
          ]
        }
      }
    }
  }
}
